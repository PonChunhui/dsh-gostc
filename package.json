{
  "name": "dsh-gostc",
  "version": "1.4.4",
  "type": "module",
  "description": "Gostc intranet-penetration manager for DeepSeek Harness: manage clients, tunnels and P2P links, and auto-download and launch the matching command-line client.",
  "license": "MIT",
  "author": "PonChunhui",
  "homepage": "https://github.com/PonChunhui/dsh-gostc#readme",
  "bugs": {
    "url": "https://github.com/PonChunhui/dsh-gostc/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PonChunhui/dsh-gostc.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gostc",
    "frp",
    "intranet-penetration",
    "remote",
    "tunnel"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./shared": "./shared.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "shared.js",
    "process.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets",
    "screenshots.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.0 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
